{
  "name": "seat-cover-title-generator",
  "private": true,
  "version": "3.3.0",
  "main": "desktop/main.cjs",
  "author": "United Seat Factory",
  "repository": {
    "type": "git",
    "url": "https://github.com/aliahmadi1382/title-generator.git"
  },
  "description": "Rule-based, account-based eBay title generator for automotive seat cover listings (manual, variation matrix, CSV batch).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "node scripts/sync-cpis.mjs --verify && eslint . && tsc --noEmit",
    "test": "node --test tests/*.test.cjs",
    "desktop": "npm run build && electron .",
    "desktop:pack": "electron-builder --win --x64 --dir --publish never",
    "desktop:dist": "electron-builder --win --x64 --publish never",
    "test:desktop": "node scripts/smoke-desktop.mjs",
    "sync:cpis": "node scripts/sync-cpis.mjs"
  },
  "dependencies": {
    "electron-updater": "6.8.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "45.3.2",
    "electron-builder": "26.18.0",
    "eslint": "9.39.5",
    "playwright": "1.65.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
