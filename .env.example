# ---------------------------------------------------------------------------
# Example environment variables. Copy to ".env.local" for local use.
# The app currently needs NONE of these (settings/history use localStorage).
# These are placeholders for future Supabase / Vercel integration.
#
# NOTE: only variables prefixed with VITE_ are exposed to the frontend.
# Never put service-role keys or private secrets here.
# ---------------------------------------------------------------------------

# Optional future Supabase settings
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional app settings
VITE_APP_NAME=Seat Cover Title Generator
